{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Haru2305/ai-intel/schemas/intel.schema.json",
  "title": "Canonical AI Intel",
  "type": "object",
  "required": [
    "id",
    "accepted_at",
    "title",
    "claim",
    "summary",
    "what_changed",
    "why_it_matters",
    "category",
    "importance",
    "novelty",
    "reliability",
    "actionability",
    "personal_value",
    "confidence",
    "status",
    "verification_status",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "first_collected_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "title": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "what_changed": {
      "type": "string"
    },
    "why_it_matters": {
      "type": "string"
    },
    "category": {
      "type": "array",
      "items": {
        "enum": [
          "models",
          "agents",
          "coding",
          "prompting",
          "local-llm",
          "research",
          "tools",
          "ai-industry"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "importance": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "novelty": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "reliability": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "actionability": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "personal_value": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "enum": [
        "accepted"
      ]
    },
    "verification_status": {
      "enum": [
        "partially_verified",
        "verified"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_candidate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "source",
          "type",
          "strength"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source": {
            "type": "string"
          },
          "type": {
            "enum": [
              "official",
              "github",
              "paper",
              "reporting",
              "practitioner",
              "community",
              "blog",
              "other"
            ]
          },
          "strength": {
            "enum": [
              "primary",
              "supporting",
              "context",
              "discovery"
            ]
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "jev": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "used": {
          "type": "boolean"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "relevance": {
          "type": [
            "number",
            "null"
          ]
        },
        "personal_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "verification_priority": {
          "type": [
            "number",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
